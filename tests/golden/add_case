#!/usr/bin/env python3
"""Create a draft golden case from a debug export.

The export supplies snapshot-derived facts; it never becomes an accepted
expectation automatically.  Reviewers choose or write the expected result and
then use the separate ``accept`` command when replacing one.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import sys
from pathlib import Path

LIB = Path(__file__).resolve().parent / "lib"
if str(LIB) not in sys.path:
    sys.path.insert(0, str(LIB))

from common import (CaseInputError, build_manifest, observed_outcome, read_export,
                    read_json, validate_capture, write_json)  # noqa: E402


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description=__doc__)
    result.add_argument("case", help="stable case directory name")
    result.add_argument("--export", required=True, help="debug export string or decoded JSON file")
    result.add_argument("--options", help="JSON generation options, including engine_scenario")
    result.add_argument("--cases", default=str(Path(__file__).resolve().parent / "cases"), help="case root")
    result.add_argument("--force", action="store_true", help="replace an existing draft case")
    return result


def main(argv: list[str] | None = None) -> int:
    args = parser().parse_args(argv)
    case_id = args.case.strip()
    if not case_id or case_id in {".", ".."} or "/" in case_id or "\\" in case_id:
        parser().error("case must be one directory name")
    case = Path(args.cases) / case_id
    try:
        if case.exists():
            existing_manifest = case / "manifest.json"
            existing = read_json(existing_manifest, "existing manifest") if existing_manifest.exists() else {}
            existing_state = existing.get("state", existing.get("status")) if isinstance(existing, dict) else None
            accepted_expectation = any((case / name).exists() for name in
                                       ("expected.json", "expected_canonical.json", "expected_blueprint.txt", "expected.blueprint"))
            if existing_state == "accepted" or (accepted_expectation and existing_state != "draft"):
                raise CaseInputError(f"refusing to overwrite accepted baseline: {case}")
            if not args.force:
                raise CaseInputError(f"case already exists: {case} (use --force only for a draft)")
            if existing_state != "draft":
                raise CaseInputError(f"--force is allowed only for a draft case: {case}")
        export, encoded = read_export(Path(args.export))
        if not isinstance(export, dict):
            raise CaseInputError("debug export must decode to an object")
        options = read_json(Path(args.options), "generation options") if args.options else {}
        if not isinstance(options, dict):
            raise CaseInputError("generation options must be a JSON object")
        manifest = build_manifest(case_id, export, options)
        capture = validate_capture(export, encoded)
        prepared = capture["prepared_input"] if capture is not None else None
        captured = prepared is not None
        # A source_kind supplied by Generation.capture is authoritative. The old
        # prepared_input-only spelling remains readable for existing tool tests,
        # but is not used by new runtime or harness captures.
        if capture is not None and capture["source_kind"] is not None:
            manifest["source_kind"] = capture["source_kind"]
        else:
            manifest["source_kind"] = "captured" if captured else "handwritten_fixture"
        supported = options.get("supported_outcome", manifest.get("expected_outcome", "production"))
        manifest["supported_outcome"] = supported
        # expected_outcome is the frozen runner spelling; supported_outcome is
        # the explicit policy field for a draft and is never changed by a failed
        # generation observation.
        manifest["expected_outcome"] = supported
        manifest["observed_outcome"] = observed_outcome(export, capture)
        manifest["state"] = "draft"
        manifest["source_export"] = "export.json"
        if captured:
            manifest["prepared_input"] = "prepared_input.json"
            # The generated result is intentionally not a checked-in actual.
            manifest["actual"] = None
        case.mkdir(parents=True, exist_ok=True)
        write_json(case / "manifest.json", manifest)
        # Retain both forms when the source was an in-game encoded export. The
        # JSON form makes review and offline reproduction straightforward.
        write_json(case / "export.json", export)
        if encoded is not None:
            (case / "export.txt").write_text(encoded + "\n", encoding="utf-8")
        write_json(case / "options.json", options)
        if prepared is not None:
            write_json(case / "prepared_input.json", prepared)
        provenance = {
            "case_id": case_id,
            "state": "draft",
            "source_kind": manifest["source_kind"],
            "source_export": "export.json",
            "export_sha256": hashlib.sha256((case / "export.json").read_bytes()).hexdigest(),
            "options_file": "options.json",
            "options_sha256": hashlib.sha256((case / "options.json").read_bytes()).hexdigest(),
            "prepared_input_file": "prepared_input.json" if prepared is not None else None,
            "prepared_input_sha256": hashlib.sha256((case / "prepared_input.json").read_bytes()).hexdigest()
                if prepared is not None else None,
            "supported_outcome": manifest["supported_outcome"],
            "observed_outcome": manifest["observed_outcome"],
        }
        if capture is not None and capture["source_export"] is not None:
            provenance["capture_source_export"] = capture["source_export"]
        if capture is not None and isinstance(capture["provenance"], dict):
            provenance["capture_provenance"] = capture["provenance"]
            for key, value in capture["provenance"].items():
                provenance.setdefault(key, value)
        write_json(case / "provenance.json", provenance)
        (case / "candidate.json").write_text("{\n  \"TODO\": \"capture candidate and review before accepting\"\n}\n",
                                               encoding="utf-8")
        print(f"DRAFT {case}")
        print("Fill candidate.json and review manifest.json; no expectation was accepted.")
        return 0
    except CaseInputError as exc:
        print(f"add_case refused: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
