#!/bin/sh
# Explicit expectation replacement. Normal tests/golden/run has no write path for expectations.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
    echo "usage: tests/golden/accept <case> [candidate]" >&2
    exit 2
fi
case_name=$1
candidate=${2-}
if [ -n "$candidate" ]; then
    exec python3 "$root/run" accept --root "$root/cases" --candidate "$candidate" "$case_name"
fi
exec python3 "$root/run" accept --root "$root/cases" "$case_name"
