+local function begin_prune(rects)
+    local order = {}
+    for i, rect in ipairs(rects) do order[i] = {index = i, rect = rect, area = rect.w * rect.h} end
+    table.sort(order, function(a, b)
+        if a.area ~= b.area then return a.area > b.area end
+        return a.index < b.index
+    end)
+    return {rects = rects, order = order, maximal = {}, keep = {}, position = 1,
+        compare_index = 1, contained = false}
+end
+
+local function continue_prune(prune, budget)
+    while prune.position <= #prune.order and budget.ops > 0 do
+        local item = prune.order[prune.position]
+        local larger = prune.maximal[prune.compare_index]
+        if larger then
+            if larger.x <= item.rect.x and larger.y <= item.rect.y
+                and larger.x + larger.w >= item.rect.x + item.rect.w
+                and larger.y + larger.h >= item.rect.y + item.rect.h then
+                prune.contained = true
+                prune.compare_index = #prune.maximal + 1
+            else
+                prune.compare_index = prune.compare_index + 1
+            end
+        else
+            if not prune.contained then
+                prune.keep[item.index] = true
+                prune.maximal[#prune.maximal + 1] = item.rect
+            end
+            prune.position, prune.compare_index, prune.contained = prune.position + 1, 1, false
+        end
+        budget.ops = budget.ops - math.min(budget.ops, 4)
+    end
+    if prune.position <= #prune.order then return nil end
+    local out = {}
+    for i, rect in ipairs(prune.rects) do if prune.keep[i] then out[#out + 1] = rect end end
+    return out
+end
