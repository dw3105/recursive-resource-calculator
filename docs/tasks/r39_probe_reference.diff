+function BeaconPrune.share(entities, others, catalog)
+    local occ = {}
+    local function mark(e, v) if type(e.x)=="number" and type(e.w)=="number" then for x=e.x,e.x+e.w-1 do for y=e.y,e.y+(e.h or 1)-1 do occ[x..":"..y]=v end end
+        elseif type(e.x)=="number" then occ[e.x..":"..e.y]=v
+        elseif e.position then occ[math.floor(e.position.x)..":"..math.floor(e.position.y)]=v end end
+    for _, e in ipairs(entities) do mark(e, e) end
+    for i, e in ipairs(others or {}) do if i<3 then local ks={} for k,v in pairs(e) do ks[#ks+1]=k.."="..tostring(v) end io.stderr:write("ROUTE_E "..table.concat(ks," ").."\n") end mark(e, e) end
+    local machines, beacons = {}, {}
+    for _, e in ipairs(entities) do if e.kind=="machine" then machines[e.id]=e end if e.kind=="beacon" then beacons[#beacons+1]=e end end
+    table.sort(beacons, function(a,b) return tostring(a.id)<tostring(b.id) end)
+    local moved = 0
+    for _, b in ipairs(beacons) do
+        if b.signature and b.required_for and not b._gone then
+            for _, o in ipairs(beacons) do
+                if o ~= b and not o._gone and o.signature == b.signature and o.required_for then
+                    local best
+                    local already = true
+                    for _, id in ipairs(o.required_for) do if not machines[id] or not reaches(b, machines[id], catalog) then already=false end end
+                    if not already then
+                    for dy=-2,2 do for dx=-2,2 do if not best then
+                        local t = {x=b.x+dx,y=b.y+dy,w=b.w,h=b.h,supply_w=b.supply_w,supply_h=b.supply_h,name=b.name}
+                        local free = true
+                        for x=t.x,t.x+t.w-1 do for y=t.y,t.y+t.h-1 do local v=occ[x..":"..y]; if v and v~=b then free=false end end end
+                        if free then
+                            local ok = true
+                            for _, id in ipairs(b.required_for) do if not machines[id] or not reaches(t, machines[id], catalog) then ok=false end end
+                            for _, id in ipairs(o.required_for) do if not machines[id] or not reaches(t, machines[id], catalog) then ok=false end end
+                            if ok then best=t end
+                        end
+                    end end end
+                    if best then
+                        io.stderr:write(string.format("PROBE_BEAC move %s (%d,%d)->(%d,%d) covers %s\n", tostring(b.id), b.x,b.y,best.x,best.y, tostring(o.id)))
+                        mark(b, nil)
+                        local ddx, ddy = best.x - b.x, best.y - b.y
+                        b.x, b.y = best.x, best.y
+                        if type(b.cx)=="number" then b.cx, b.cy = b.cx+ddx, b.cy+ddy end
+                        if type(b.position)=="table" then b.position = {x=b.position.x+ddx, y=b.position.y+ddy} end
+                        mark(b, b)
+                        moved = moved + 1
+                        for _, field in ipairs({"required_for","covered_members","member_ids","members"}) do
+                            if type(b[field])=="table" then for _, id in ipairs(o[field] or {}) do b[field][#b[field]+1]=id end end
+                        end
+                        o._gone = true
+                        break
+                    end
+                    end
+                end
+            end
+        end
+    end
+    if moved > 0 then
+        local kept = {}
+        for _, e in ipairs(entities) do if not e._gone then kept[#kept+1]=e end end
+        for i=#entities,1,-1 do entities[i]=nil end
+        for i,e in ipairs(kept) do entities[i]=e end
+    end
+    return moved
+end
+
 return BeaconPrune
